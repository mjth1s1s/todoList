<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TEST"
        android:textStyle="bold"
        android:textSize="22sp"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:background="#6B5CD9" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:progressDrawable="@drawable/progress_track"
        android:progress="30"
        android:max="100"
        android:layout_marginTop="7dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:progressTint="#8E82F1"
        android:layout_marginBottom="20dp" />

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3-문장 요약"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="12dp"/>

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coffee, originally from Ethiopia, ... like ________ acid, which may reduce disease risk."
                android:textSize="16sp"
                android:background="#E8E5FA"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#F7F4FF"
                android:backgroundTintMode="src_over"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="빈칸에 단어를 써넣으세요"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>


            <ImageButton
                android:id="@+id/btnInput"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/write"
                android:backgroundTint="#7D5FFF"
                android:layout_gravity="center_horizontal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/tvAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="__________"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnCheckAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check answers"
                android:textColor="#FFFFFF"
                android:backgroundTint="#7D5FFF"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
