<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VIDEO"
        android:textStyle="bold"
        android:textSize="22sp"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:background="#6B5CD9" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:progress="30"
        android:max="100"
        android:progressTint="#BCAAF5"
        android:layout_marginBottom="0dp" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Coffee and what it does to your body"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" />

    <FrameLayout
        android:id="@+id/youtubeFrame"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginHorizontal="0dp"
        android:background="#000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#333333"
            android:text="(스크롤 가능한 영어 자막 내용)"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <Button
        android:id="@+id/startShadowingButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Shadowing"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:background="@drawable/btn_next_background"
        android:layout_margin="10dp"
        android:layout_marginBottom="24dp" />
</LinearLayout>